# Project Settings
PROJECT_NAME="Secure E-Commerce Admin Portal"
APP_ENV=development
DEBUG=False
API_V1_PREFIX=/api/v1
SECRET_KEY="e-commerce-lab-secure-secret-key-min-32-chars-long!"

# Database & In-Memory Redis
DATABASE_URL=sqlite:///./data/ecommerce.db
REDIS_URL=redis://localhost:6379/0

# Session & Hardening Timeouts
SESSION_COOKIE_NAME=session_id
SESSION_IDLE_TIMEOUT_SECONDS=900        # 15 minutes idle timeout
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800   # 8 hours absolute timeout
PRE_MFA_SESSION_TIMEOUT_SECONDS=300     # 5 minutes pre-MFA temp session

# Anti-Replay
OTP_REPLAY_TTL_SECONDS=90               # 90 seconds (3x 30s TOTP steps)

# Cookie Flags
COOKIE_HTTPONLY=True
COOKIE_SECURE=False                     # Set to True when using HTTPS in production
COOKIE_SAMESITE=lax

# Audit & Logging
AUDIT_LOG_FILE=logs/audit.log
