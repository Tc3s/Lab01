# ==============================================================================
# Environment Configuration Blueprint: Secure E-Commerce Admin Portal
# ==============================================================================

# Application Meta & Security Key
PROJECT_NAME="Secure E-Commerce Admin Portal"
APP_ENV=development
DEBUG=False
API_V1_PREFIX=/api/v1
SECRET_KEY="e-commerce-lab-secure-secret-key-min-32-chars-long!"

# Database & In-Memory Redis
# For local host execution use redis://localhost:6379/0
# In Docker Compose, web connects to redis container via redis://redis:6379/0
DATABASE_URL=sqlite:///./data/ecommerce.db
REDIS_URL=redis://localhost:6379/0

# Session Hardening & Timeout Policies (R1.3)
SESSION_COOKIE_NAME=session_id
SESSION_IDLE_TIMEOUT_SECONDS=900        # 15 minutes rolling idle timeout
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800   # 8 hours absolute session ceiling
PRE_MFA_SESSION_TIMEOUT_SECONDS=300     # 5 minutes temporary pre-MFA session

# TOTP & Anti-Replay Guard (R1.1, R1.2)
OTP_REPLAY_TTL_SECONDS=90               # 90 seconds (covers 3x 30s drift window)

# Cookie Security Flags (R1.3)
COOKIE_HTTPONLY=True
COOKIE_SECURE=False                     # Set to True when deploying behind HTTPS/TLS
COOKIE_SAMESITE=lax

# SIEM Audit Logging (R1.5)
AUDIT_LOG_FILE=logs/audit.log

# Docker Host Port Overrides (Milestone 4)
WEB_PORT=8000
REDIS_PORT=6380                         # Avoids collision with host native Redis on 6379

